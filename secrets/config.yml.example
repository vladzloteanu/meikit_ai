# Factory secrets: the schema of secrets/config.yml.enc (docs/secrets.md).
# First setup: make secrets-init; cp secrets/config.yml.example secrets/config.yml; fill it in;
# bin/secrets encrypt; rm secrets/config.yml. Later changes: make secrets-edit.
operator:                     # legal pages and the fake-door disclosure
  name: ""
  address: ""
  email: ""
  siren: ""
nb:                           # NeuralBox; api_key comes from `uv run factory secrets-import-nb`
  url: "http://127.0.0.1:3076"
  api_key: ""
  user_email: ""
providers:                    # research keys; NeuralBox's are copied by `uv run factory secrets-import-nb`
  searchapi:
    api_key: ""
  seranking:
    api_token: ""
  apify:
    api_key: ""
  firecrawl:
    api_key: ""
  tavily:
    api_key: ""
  screenshotapi:
    token: ""
  gemini:
    vertex_ai: {}
  openai:
    api_key: ""
  legnext:
    api_key: ""
  fal:
    api_key: ""
  elevenlabs:
    api_key: ""
  submagic:
    api_key: ""
accounts:
  github:
    owner: vladzloteanu         # repo creation uses the logged-in gh CLI
  vercel:
    scope: vladzloteanu-4035    # the personal scope; the logged-in Vercel CLI does the work
  meta:
    business_id: ""
    ad_account_id: ""
    system_user_token: ""
    app_id: ""
    app_secret: ""
  google_ads:
    customer_id: ""
    developer_token: ""
    oauth: {}
  stripe:
    secret_key: ""
  porkbun:
    api_key: ""
    secret: ""
  resend:
    account_key: ""             # mints per-domain sending keys
  sending_domain:
    domain: ""
    tool: ""
    api_key: ""
  turnstile:
    site_key: ""
    secret_key: ""
ideas: {}                     # <slug>: {master_key, stats_token}, the only way into that idea's secrets
