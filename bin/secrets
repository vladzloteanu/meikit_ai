#!/usr/bin/env bash
#
# bin/secrets - Encrypted credentials management
#
# Uses OpenSSL AES-256-CBC with PBKDF2 (100k iterations) for encryption.
# Works on macOS and Linux.
#
# This copy differs from the shared script in two points (docs/secrets.md): openssl reads the
# key from the key file (-pass file:), so the key never appears on a command line; and the git
# textconv prints one hash per value unless SECRETS_TEXTCONV=full.
#
# Usage:
#   bin/secrets init                              First-time setup
#   bin/secrets encrypt [plaintext] [enc] [key]   Encrypt a file
#   bin/secrets decrypt [enc] [key] [output]      Decrypt to stdout or file
#   bin/secrets edit [enc] [key]                  Decrypt -> $EDITOR -> re-encrypt
#   bin/secrets cat                               Print decrypted config to stdout
#   bin/secrets get <dotpath>                     Extract a single YAML value
#   bin/secrets apply-diff [enc] [key]            Apply unified diff from stdin
#   bin/secrets generate-key [keyfile]            Generate random master key
#   bin/secrets decrypt-for-textconv [key] <path> Internal: git textconv filter (hashes;
#                                                 SECRETS_TEXTCONV=full for plaintext)

set -euo pipefail

# --- Auto-detect paths ---

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
SECRETS_DIR="$PROJECT_ROOT/secrets"

DEFAULT_KEYFILE="$SECRETS_DIR/master.key"
DEFAULT_PLAINTEXT="$SECRETS_DIR/config.yml"
DEFAULT_ENCRYPTED="$SECRETS_DIR/config.yml.enc"

PBKDF2_ITERATIONS=100000

# Pick a Python with pyyaml available. Prefer the project venv (created by
# install.sh); fall back to system python3 so this script still works on hosts
# where pyyaml is somehow already importable (CI, dev machines).
if [ -x "$PROJECT_ROOT/.venv/bin/python" ]; then
  SECRETS_PY="$PROJECT_ROOT/.venv/bin/python"
else
  SECRETS_PY="python3"
fi

# --- Helpers ---

die() { echo "Error: $*" >&2; exit 1; }

usage() {
  cat <<'EOF'
Usage: bin/secrets <command> [args]

Commands:
  init                                     First-time setup (generate key, create structure, configure git)
  encrypt [plaintext] [encrypted] [key]    Encrypt a file (defaults: secrets/config.yml -> secrets/config.yml.enc)
  decrypt [encrypted] [key] [output]       Decrypt to stdout or file (defaults: secrets/config.yml.enc)
  edit [encrypted] [key]                   Decrypt -> $EDITOR -> re-encrypt
  cat                                      Print decrypted config to stdout
  get <dotpath>                            Extract a single YAML value (e.g., platforms.timeone.password)
  apply-diff [encrypted] [key]             Apply unified diff from stdin, re-encrypt
  generate-key [keyfile]                   Generate random 32-byte hex master key
  decrypt-for-textconv [key] <filepath>    Internal: git textconv filter, one hash per value
                                           (SECRETS_TEXTCONV=full prints the plaintext)
EOF
  exit 1
}

# openssl reads the key from the file itself (-pass file:), so it is never on a command line.
require_keyfile() {
  [ -f "$1" ] || die "Key file not found: $1"
}

# Portable checksum (macOS: md5 -q, Linux: md5sum)
file_checksum() {
  if command -v md5sum >/dev/null 2>&1; then
    md5sum "$1" | cut -d' ' -f1
  else
    md5 -q "$1"
  fi
}

# Validate YAML syntax. Returns 0 if valid, 1 if invalid (prints error).
validate_yaml() {
  local file="$1"
  local err
  err=$("$SECRETS_PY" -c "
import yaml, sys
try:
    yaml.safe_load(open(sys.argv[1]))
except yaml.YAMLError as e:
    print(e, file=sys.stderr)
    sys.exit(1)
" "$file" 2>&1)
  if [ $? -ne 0 ]; then
    echo "YAML validation failed:" >&2
    echo "$err" >&2
    return 1
  fi
  return 0
}

# Print the YAML on stdin as one line per value, sorted by dotpath: `dotpath: <first 8 hex
# digits of the value's sha256>`, or `dotpath: (empty)`. Shows which keys changed, never a value.
render_hashes() {
  "$SECRETS_PY" -c "
import hashlib, sys, yaml
try:
    data = yaml.safe_load(sys.stdin)
except yaml.YAMLError:
    print('(not valid YAML)')
    sys.exit(0)
lines = []
def walk(node, path):
    if isinstance(node, dict) and node:
        for key, value in node.items():
            walk(value, path + '.' + str(key) if path else str(key))
    elif isinstance(node, list) and node:
        for index, value in enumerate(node):
            walk(value, path + '.' + str(index) if path else str(index))
    elif node is None or node == '' or node == {} or node == []:
        lines.append((path, '(empty)'))
    else:
        lines.append((path, hashlib.sha256(str(node).encode()).hexdigest()[:8]))
walk(data, '')
for path, shown in sorted(lines):
    print(path + ': ' + shown)
"
}

do_encrypt() {
  local infile="$1" outfile="$2" keyfile="$3"
  openssl enc -aes-256-cbc -salt -pbkdf2 -iter "$PBKDF2_ITERATIONS" \
    -in "$infile" -out "$outfile" -pass "file:$keyfile"
}

do_decrypt() {
  local infile="$1" keyfile="$2"
  openssl enc -aes-256-cbc -d -pbkdf2 -iter "$PBKDF2_ITERATIONS" \
    -in "$infile" -pass "file:$keyfile"
}

# --- Commands ---

cmd_init() {
  echo "Initializing secrets..."

  # Create directory structure
  mkdir -p "$SECRETS_DIR"

  # Generate master key if not exists
  if [ -f "$DEFAULT_KEYFILE" ]; then
    echo "Master key already exists: $DEFAULT_KEYFILE"
  else
    openssl rand -hex 32 > "$DEFAULT_KEYFILE"
    chmod 600 "$DEFAULT_KEYFILE"
    echo "Generated master key: $DEFAULT_KEYFILE"
  fi

  # Configure git textconv
  local abs_script
  abs_script="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
  local abs_keyfile
  abs_keyfile="$(cd "$(dirname "$DEFAULT_KEYFILE")" && pwd)/$(basename "$DEFAULT_KEYFILE")"

  git -C "$PROJECT_ROOT" config diff.encrypted.textconv "$abs_script decrypt-for-textconv $abs_keyfile"
  echo "Configured git textconv for encrypted diffs."

  # Remind about config
  if [ ! -f "$DEFAULT_ENCRYPTED" ]; then
    echo ""
    echo "Next steps:"
    echo "  1. cp secrets/config.yml.example secrets/config.yml"
    echo "  2. Fill in your credentials in secrets/config.yml"
    echo "  3. bin/secrets encrypt"
    echo "  4. rm secrets/config.yml  (the .enc file is what you keep)"
  fi

  echo "Done."
}

cmd_generate_key() {
  local keyfile="${1:-$DEFAULT_KEYFILE}"
  if [ -f "$keyfile" ]; then
    die "Key file already exists: $keyfile (delete it first if you want to regenerate)"
  fi
  mkdir -p "$(dirname "$keyfile")"
  openssl rand -hex 32 > "$keyfile"
  chmod 600 "$keyfile"
  echo "Generated master key: $keyfile"
}

cmd_encrypt() {
  local plaintext="${1:-$DEFAULT_PLAINTEXT}"
  local encrypted="${2:-$DEFAULT_ENCRYPTED}"
  local keyfile="${3:-$DEFAULT_KEYFILE}"
  [ -f "$plaintext" ] || die "Plaintext file not found: $plaintext"
  validate_yaml "$plaintext" || die "Invalid YAML. Refusing to encrypt."
  require_keyfile "$keyfile"
  mkdir -p "$(dirname "$encrypted")"
  do_encrypt "$plaintext" "$encrypted" "$keyfile"
  echo "Encrypted: $plaintext -> $encrypted"
}

cmd_decrypt() {
  local encrypted="${1:-$DEFAULT_ENCRYPTED}"
  local keyfile="${2:-$DEFAULT_KEYFILE}"
  local output="${3:-}"
  [ -f "$encrypted" ] || die "Encrypted file not found: $encrypted"
  require_keyfile "$keyfile"
  if [ -n "$output" ]; then
    do_decrypt "$encrypted" "$keyfile" > "$output"
    echo "Decrypted: $encrypted -> $output"
  else
    do_decrypt "$encrypted" "$keyfile"
  fi
}

cmd_edit() {
  local encrypted="${1:-$DEFAULT_ENCRYPTED}"
  local keyfile="${2:-$DEFAULT_KEYFILE}"
  [ -f "$encrypted" ] || die "Encrypted file not found: $encrypted"
  require_keyfile "$keyfile"

  local editor="${EDITOR:-vi}"
  local tmpfile
  tmpfile=$(mktemp "${TMPDIR:-/tmp}/secrets.XXXXXX")

  # Decrypt to temp file
  do_decrypt "$encrypted" "$keyfile" > "$tmpfile"
  local checksum_before
  checksum_before=$(file_checksum "$tmpfile")

  # Open editor
  "$editor" "$tmpfile"

  # Check if file was modified
  local checksum_after
  checksum_after=$(file_checksum "$tmpfile")
  if [ "$checksum_before" = "$checksum_after" ]; then
    rm -f "$tmpfile"
    echo "No changes made, skipping re-encryption."
    return 0
  fi

  # Validate YAML before re-encrypting
  if ! validate_yaml "$tmpfile"; then
    rm -f "$tmpfile"
    die "Invalid YAML. Changes discarded."
  fi

  # Re-encrypt
  do_encrypt "$tmpfile" "$encrypted" "$keyfile"
  rm -f "$tmpfile"
  echo "Re-encrypted: $encrypted"
}

cmd_cat() {
  cmd_decrypt "$DEFAULT_ENCRYPTED" "$DEFAULT_KEYFILE"
}

cmd_get() {
  local dotpath="${1:?Usage: bin/secrets get <dotpath>  (e.g., platforms.timeone.password)}"
  [ -f "$DEFAULT_ENCRYPTED" ] || die "Encrypted config not found: $DEFAULT_ENCRYPTED"
  require_keyfile "$DEFAULT_KEYFILE"
  local yaml_content
  yaml_content=$(do_decrypt "$DEFAULT_ENCRYPTED" "$DEFAULT_KEYFILE")
  "$SECRETS_PY" -c "
import yaml, sys
data = yaml.safe_load(sys.stdin)
keys = sys.argv[1].split('.')
val = data
for k in keys:
    if isinstance(val, dict) and k in val:
        val = val[k]
    else:
        print(f'Key not found: {sys.argv[1]}', file=sys.stderr)
        sys.exit(1)
print(val)
" "$dotpath" <<< "$yaml_content"
}

cmd_apply_diff() {
  local encrypted="${1:-$DEFAULT_ENCRYPTED}"
  local keyfile="${2:-$DEFAULT_KEYFILE}"
  [ -f "$encrypted" ] || die "Encrypted file not found: $encrypted"
  require_keyfile "$keyfile"

  local tmpfile difffile
  tmpfile=$(mktemp "${TMPDIR:-/tmp}/secrets.XXXXXX")
  difffile=$(mktemp "${TMPDIR:-/tmp}/secrets-diff.XXXXXX")

  # Read diff from stdin
  cat > "$difffile"

  # Decrypt to temp file
  do_decrypt "$encrypted" "$keyfile" > "$tmpfile"

  # Apply patch
  if ! patch --no-backup-if-mismatch "$tmpfile" < "$difffile"; then
    rm -f "$tmpfile" "$difffile"
    die "Failed to apply diff"
  fi

  # Validate YAML before re-encrypting
  if ! validate_yaml "$tmpfile"; then
    rm -f "$tmpfile" "$difffile"
    die "Invalid YAML after applying diff. Changes discarded."
  fi

  # Re-encrypt
  do_encrypt "$tmpfile" "$encrypted" "$keyfile"
  rm -f "$tmpfile" "$difffile"
  echo "Diff applied and re-encrypted: $encrypted"
}

cmd_decrypt_for_textconv() {
  local keyfile="${1:-$DEFAULT_KEYFILE}"
  local filepath="${2:?Usage: bin/secrets decrypt-for-textconv [keyfile] <filepath>}"
  [ -f "$filepath" ] || exit 0
  require_keyfile "$keyfile"
  if [ "${SECRETS_TEXTCONV:-}" = "full" ]; then
    do_decrypt "$filepath" "$keyfile" 2>/dev/null || echo "(decryption failed)"
    return 0
  fi
  local plaintext
  if ! plaintext=$(do_decrypt "$filepath" "$keyfile" 2>/dev/null); then
    echo "(decryption failed)"
    return 0
  fi
  printf '%s\n' "$plaintext" | render_hashes
}

# --- Main ---

[ $# -ge 1 ] || usage

command="$1"
shift

case "$command" in
  init)               cmd_init "$@" ;;
  generate-key)       cmd_generate_key "$@" ;;
  encrypt)            cmd_encrypt "$@" ;;
  decrypt)            cmd_decrypt "$@" ;;
  edit)               cmd_edit "$@" ;;
  cat)                cmd_cat "$@" ;;
  get)                cmd_get "$@" ;;
  apply-diff)         cmd_apply_diff "$@" ;;
  decrypt-for-textconv) cmd_decrypt_for_textconv "$@" ;;
  -h|--help|help)     usage ;;
  *)                  die "Unknown command: $command (run 'bin/secrets help' for usage)" ;;
esac
